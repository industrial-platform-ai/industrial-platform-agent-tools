{
  "name": "@industrial-platform/sentinel",
  "version": "0.4.1",
  "description": "24/7 autonomous treasury and payment monitoring for funded agents with bounded x402 spend and meaningful webhook alerts for wallet, treasury, transaction and payment events.",
  "type": "module",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "validate": "npm run build && npx clawhub package validate . --out .clawhub-validation"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "openclaw": ">=2026.5.17",
    "typescript": "^7.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    },
    "hostTargets": [
      "gateway"
    ]
  },
  "keywords": [
    "openclaw",
    "treasury",
    "payments",
    "wallet",
    "transactions",
    "monitoring",
    "always-on",
    "x402",
    "autonomous-agents"
  ]
}
