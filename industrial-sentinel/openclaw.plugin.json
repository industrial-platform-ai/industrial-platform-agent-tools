{
  "id": "industrial-sentinel",
  "name": "Autonomous Treasury & Payment Sentinel",
  "description": "Keep an autonomous wallet funded, observable and operational 24/7 with recurring wallet activity, treasury state, transaction completion, payment-failure detection and bounded-spend monitoring.",
  "categories": [
    "finance-payments"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "industrial_sentinel_status",
      "industrial_sentinel_run_now"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "payerAdapterUrl",
      "jobs"
    ],
    "properties": {
      "payerAdapterUrl": {
        "type": "string",
        "description": "Runtime-owned local HTTP adapter that executes x402-paid requests. Recommended loopback URL."
      },
      "maxDailyUsd": {
        "type": "number",
        "minimum": 0,
        "default": 5
      },
      "jobs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "intervalSeconds"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "wallet-monitor",
                "transaction-watch",
                "treasury-snapshot",
                "pretrade-context"
              ]
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 15
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "input": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "alertWebhookUrl": {
        "type": "string",
        "description": "Optional HTTPS webhook for first-success, meaningful state-change, error and spend-cap alerts. Loopback http is allowed for local relays."
      },
      "alertOnEverySuccess": {
        "type": "boolean",
        "default": false,
        "description": "When true, also emit an alert after every successful monitoring cycle. Default false to avoid noisy polling alerts."
      }
    }
  }
}
