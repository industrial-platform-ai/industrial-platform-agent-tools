{
  "title": "Web Metadata Intelligence input",
  "type": "object",
  "schemaVersion": 1,
  "additionalProperties": false,
  "properties": {
    "urls": {
      "title": "URLs",
      "type": "array",
      "description": "Public HTTP/HTTPS pages to inspect. Up to 100 unique URLs per run.",
      "editor": "stringList",
      "items": { "type": "string", "maxLength": 2048 },
      "minItems": 1,
      "maxItems": 100
    },
    "timeout_seconds": {
      "title": "Per-URL timeout",
      "type": "integer",
      "default": 30,
      "minimum": 5,
      "maximum": 60,
      "unit": "seconds"
    },
    "concurrency": {
      "title": "Concurrency",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": ["urls"]
}
