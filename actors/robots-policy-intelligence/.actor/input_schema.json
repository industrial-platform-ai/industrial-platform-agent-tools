{
  "title": "Robots Policy Intelligence input",
  "type": "object",
  "schemaVersion": 1,
  "additionalProperties": false,
  "properties": {
    "sites": {
      "title": "Sites",
      "type": "array",
      "description": "Public domains or HTTP/HTTPS URLs. Up to 100 unique sites per run.",
      "editor": "stringList",
      "items": { "type": "string", "maxLength": 2048 },
      "minItems": 1,
      "maxItems": 100,
      "prefill": ["https://example.com/"],
      "example": ["https://example.com/"]
    },
    "user_agents": {
      "title": "User agents",
      "type": "array",
      "description": "Crawler user-agent tokens to evaluate.",
      "editor": "stringList",
      "items": { "type": "string", "maxLength": 200 },
      "default": ["*"],
      "maxItems": 25
    },
    "test_paths": {
      "title": "Paths to test",
      "type": "array",
      "description": "URL paths or full URLs to test against the parsed rules.",
      "editor": "stringList",
      "items": { "type": "string", "maxLength": 2048 },
      "default": ["/"],
      "maxItems": 100
    },
    "timeout_seconds": {
      "title": "Per-site timeout",
      "type": "integer",
      "default": 20,
      "minimum": 5,
      "maximum": 60,
      "unit": "seconds"
    },
    "concurrency": {
      "title": "Concurrency",
      "type": "integer",
      "default": 10,
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": ["sites"]
}
